# Supabase → Project Settings → Database → Connection string
# Pooled (Transaction mode, port 6543) — used by the app at runtime on Vercel
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
# Session pooler (port 5432) — used only by `prisma migrate` (the db.<ref> direct host is IPv6-only)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Logins. Staff = quotes only. Manager = everything (products, prices, analytics, settings).
STAFF_PASSWORD="change-me-staff"
MANAGER_PASSWORD="change-me-manager"
# Random 32+ char string used to sign login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Vercel Blob (Vercel → Storage → Blob → connect to project; token is added automatically).
# If empty in local dev, photos are stored inline in the database instead.
BLOB_READ_WRITE_TOKEN=""

# Store timezone — daily quote numbering and analytics hours use this.
STORE_TIMEZONE="Asia/Kolkata"
# First product serial number.
SERIAL_START="1001"
